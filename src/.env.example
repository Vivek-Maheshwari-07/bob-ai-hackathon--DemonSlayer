# ==============================================================================
# Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO SOURCE CONTROL.
# Copy this file to src/.env and fill in the appropriate values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safety_ctd_db

# ------------------------------------------------------------------------------
# IBM watsonx.ai Configuration
# ------------------------------------------------------------------------------
# API Key for accessing IBM Cloud / watsonx.ai services
WATSONX_API_KEY=your-watsonx-api-key-here

# Project ID associated with the watsonx.ai workspace
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# URL endpoint for IBM watsonx.ai foundation models
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ------------------------------------------------------------------------------
# IBM Bob AI Copilot Configuration
# ------------------------------------------------------------------------------
# Configuration parameters / endpoint settings for IBM Bob AI integration
IBM_BOB_CONFIG={"model": "ibm/granite-13b-chat-v2", "temperature": 0.2, "max_tokens": 1024}

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Module M4 CTD RAG Checker)
# ------------------------------------------------------------------------------
# API Key for Google Gemini 2.5 Flash foundation model
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
