# ==============================================================================
# Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO SOURCE CONTROL.
# Copy this file to src/.env and fill in the appropriate values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (NOT currently used)
# ------------------------------------------------------------------------------
# The app ships with all FAERS/PRR data and the ICH M4 knowledge base as flat
# files (src/backend/app/data, src/backend/app/m4_rag/knowledge) — nothing in
# the current codebase reads DATABASE_URL. It's reserved for future use; you
# do NOT need to provision a database to run or deploy this app today.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safety_ctd_db

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (IBM Bob Copilot + Module M4 CTD RAG Checker)
# ------------------------------------------------------------------------------
# API Key for Google Gemini 2.5 Flash foundation model. Powers both the IBM Bob
# Copilot's conversational answers and the M4 grounded gap-reasoning narratives.
# Optional — the platform runs a fully deterministic offline fallback when this
# is left empty, so it is not required to demo or evaluate the app.
GEMINI_API_KEY=your-google-gemini-api-key-here

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default shown below; in production set this to your deployed
# Vercel URL(s), e.g.:
#   CORS_ORIGINS=https://pharmsignals.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:3000

# Optional: additionally allow origins matching a regex, useful for Vercel's
# per-deploy preview URLs (which change on every push). Leave unset locally.
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
# Local dev default shown below; in production (Vercel) set this to your
# deployed Render backend URL, e.g.:
#   NEXT_PUBLIC_API_BASE_URL=https://pharmsignals-backend.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
